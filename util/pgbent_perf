#!/bin/bash

# Run Linux perf with privileges the postgres user normally lacks.
# Suggested install directory is /usr/local/bin
#
# Starting from a checkout of pgbent into the postgres user's home directory, you
# likely need to run sudo as another user to install this, then add a sudo rule to allow
# the postgres user to run it.  This idiom works here:
#
#    cp util/pgbent_perf /tmp
#    logout
#    sudo cp /tmp/pgbent_perf /usr/local/bin/
#    sudo sh -c "echo \"postgres ALL = (ALL) NOPASSWD: /usr/local/bin/pgbent_perf\" >> /etc/sudoers.d/postgres"
#
# Used by util/osm-rel-prof:
#    sudo /usr/local/bin/pgbent_perf record -a -g -o osm-rel-perf.data
#    sudo /usr/local/bin/pgbent_perf stop -o osm-rel-perf.data
#    sudo /usr/local/bin/pgbent_perf report -i osm-rel-perf.data --stdio
#
# `record` must not exec perf: SIGINT to sudo does not always reach the perf
# child, and postgres cannot signal a root perf.  This wrapper traps signals,
# and `stop` is the sudoers-allowed way to reap leftover recorders.
#
# Stopping must wait for perf to flush — same idea as a Postgres shutdown
# with a large shared_buffers: SIGINT / smart stop, then give it a long
# time to write before escalating.  A one-hour system-wide sample is
# multi-GB; a 15–20s wait then SIGKILL leaves osm-rel-perf.data with
# "data size field is 0" (court 22/23/145).  Default flush budget is 10
# minutes (`PGBENT_PERF_FLUSH_SEC`).

PERF=/usr/bin/perf
if [ ! -x "$PERF" ]; then
  PERF=$(command -v perf 2>/dev/null || true)
fi
if [ -z "$PERF" ] || [ ! -x "$PERF" ]; then
  echo "pgbent_perf: perf not found" >&2
  exit 1
fi

if [ -z "$PGBENT_PERF_FLUSH_SEC" ] || [ "$PGBENT_PERF_FLUSH_SEC" = "0" ]; then
  FLUSH_SEC=600
else
  FLUSH_SEC="$PGBENT_PERF_FLUSH_SEC"
fi

output_from_args() {
  local prev="" a
  for a in "$@"; do
    if [ "$prev" = "-o" ] || [ "$prev" = "--output" ]; then
      printf '%s\n' "$a"
      return 0
    fi
    prev="$a"
  done
  return 1
}

# PIDs whose cmdline is a pgbent relation-phase recorder for $out (or any
# osm-rel-perf.data if $out is empty).  Does not match `pgbent_perf stop`.
# Prefer the pgbent_perf wrapper; bare `perf record` is a fallback.
recorder_pids() {
  local out="$1" mode="$2" pid cmd
  for pid in /proc/[0-9]*; do
    pid=${pid#/proc/}
    [ -r "/proc/$pid/cmdline" ] || continue
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || continue
    case "$cmd" in
      *pgbent_perf\ stop*) continue ;;
    esac
    case "$mode" in
      wrapper)
        case "$cmd" in
          *pgbent_perf\ record*) ;;
          *) continue ;;
        esac
        ;;
      perf)
        case "$cmd" in
          *pgbent_perf\ record*) continue ;;
          *perf\ record*) ;;
          *) continue ;;
        esac
        ;;
      *)
        case "$cmd" in
          *pgbent_perf\ record*|*perf\ record*) ;;
          *) continue ;;
        esac
        ;;
    esac
    if [ -n "$out" ]; then
      case "$cmd" in
        *"$out"*) printf '%s\n' "$pid" ;;
      esac
    else
      case "$cmd" in
        *osm-rel-perf.data*) printf '%s\n' "$pid" ;;
      esac
    fi
  done
}

signal_pids() {
  local sig="$1" pid
  shift
  for pid in "$@"; do
    [ -z "$pid" ] && continue
    kill -s "$sig" "$pid" 2>/dev/null || true
  done
}

any_alive() {
  local pid
  for pid in "$@"; do
    [ -z "$pid" ] && continue
    if [ -d "/proc/$pid" ]; then
      return 0
    fi
  done
  return 1
}

# Wait until recorders exit.  Overall budget is FLUSH_SEC — multi-GB
# system-wide samples need minutes to write the data-file trailer.
wait_flush() {
  local out="$1"
  shift
  local pids="$*"
  local i=0
  while [ "$i" -lt "$FLUSH_SEC" ]; do
    pids=$(recorder_pids "$out" all | sort -u | tr '\n' ' ')
    # shellcheck disable=SC2086
    if [ -z "$(echo $pids | tr -d '[:space:]')" ]; then
      return 0
    fi
    # shellcheck disable=SC2086
    if ! any_alive $pids; then
      return 0
    fi
    sleep 1
    i=$((i + 1))
  done
  pids=$(recorder_pids "$out" all | sort -u | tr '\n' ' ')
  # shellcheck disable=SC2086
  if [ -z "$(echo $pids | tr -d '[:space:]')" ] || ! any_alive $pids; then
    return 0
  fi
  return 1
}

stop_recorders() {
  local out="$1"
  local pids
  # INT the wrapper first so its trap asks perf to flush the data file.
  pids=$(recorder_pids "$out" wrapper | sort -u)
  if [ -z "$pids" ]; then
    pids=$(recorder_pids "$out" perf | sort -u)
  fi
  if [ -z "$pids" ]; then
    return 0
  fi
  # shellcheck disable=SC2086
  signal_pids INT $pids
  # shellcheck disable=SC2086
  if wait_flush "$out" $pids; then
    return 0
  fi
  pids=$(recorder_pids "$out" all | sort -u)
  if [ -z "$pids" ]; then
    return 0
  fi
  echo "pgbent_perf: recorders still running after ${FLUSH_SEC}s flush wait; sending SIGKILL (data may be unreadable)" >&2
  # shellcheck disable=SC2086
  signal_pids KILL $pids
  local i=0
  while [ "$i" -lt 10 ]; do
    # shellcheck disable=SC2086
    any_alive $pids || return 0
    sleep 1
    i=$((i + 1))
  done
  return 1
}

if [ "$1" = "stop" ]; then
  shift
  out=""
  if [ "$1" = "-o" ] || [ "$1" = "--output" ]; then
    out="$2"
  elif [ -n "$1" ]; then
    out="$1"
  fi
  stop_recorders "$out"
  exit 0
fi

if [ "$1" = "record" ]; then
  shift
  out=$(output_from_args "$@") || out=""
  child=""
  shutdown() {
    if [ -n "$child" ]; then
      kill -INT "$child" 2>/dev/null || true
      local i=0
      while [ "$i" -lt "$FLUSH_SEC" ] && [ -d "/proc/$child" ]; do
        sleep 1
        i=$((i + 1))
      done
      if [ -d "/proc/$child" ]; then
        echo "pgbent_perf: perf record still running after ${FLUSH_SEC}s; SIGKILL (data may be unreadable)" >&2
        kill -KILL "$child" 2>/dev/null || true
      fi
      wait "$child" 2>/dev/null || true
      child=""
    fi
  }
  trap shutdown INT TERM HUP
  "$PERF" record "$@" &
  child=$!
  wait "$child"
  rc=$?
  trap - INT TERM HUP
  child=""
  if [ -n "$SUDO_USER" ] && [ -n "$out" ] && [ -e "$out" ]; then
    chown "$SUDO_USER:" "$out" 2>/dev/null || true
  fi
  exit $rc
fi

exec "$PERF" "$@"
