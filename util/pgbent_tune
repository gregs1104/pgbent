#!/bin/bash
# Linux tune disks and CPU for PostgreSQL benchmarking.
# Suggested install directory is /usr/local/bin
#
# Starting from a checkout of pgbent into the postgres user's home directory, you
# likely need to run sudo as another user to install this, then add a sudo rule to allow
# the postgres user to run it.  This idiom works here:
#
#    cp util/pgbent_tune /tmp
#    logout
#    sudo cp /tmp/pgbent_tune /usr/local/bin/
#    sudo sh -c "echo \"postgres ALL = (ALL) NOPASSWD: /usr/local/bin/pgbent_tune\" >> /etc/sudoers.d/postgres"
#
# Read-ahead defaults to 4096 sectors (= 2048 KiB via blockdev --setra).  For
# per-experiment values use util/pgbent_setra (NOPASSWD sibling of this script).
#
# NVMe interrupt coalescing is disabled when nvme-cli is installed.  Some OEM firmware
# (DGX Spark's Samsung MZALC4T0HBL1) ships with 100us/threshold 8 coalescing, which holds
# every low queue depth read for the full 100us timer:  ~5x QD1 read latency, and 2-3x
# lower select-scatter TPS.  The timer's minimum nonzero value is 100us, so off is the
# only useful setting.  See docs/studies/arm-random-read-vs-x86.  Not saved to the drive;
# a power cycle restores the firmware default until this runs again.

/usr/bin/cpupower frequency-set --governor=performance
/usr/bin/lsblk --nodeps -n -o NAME | xargs -I{} --max-args=1 /usr/sbin/blockdev --setra 4096 /dev/{}
/usr/sbin/blockdev --report | grep -v "/dev/loop"
NVME=$(command -v nvme)
if [ -n "$NVME" ] ; then
  for c in $(ls /sys/class/nvme 2>/dev/null) ; do
    before=$($NVME get-feature /dev/$c -f 8 2>/dev/null | tail -1 | sed 's/.*Current value://')
    $NVME set-feature /dev/$c -f 8 -V 0 >/dev/null 2>&1
    after=$($NVME get-feature /dev/$c -f 8 2>/dev/null | tail -1 | sed 's/.*Current value://')
    echo "$c interrupt coalescing:$before ->$after"
  done
fi
/usr/sbin/fstrim -av
