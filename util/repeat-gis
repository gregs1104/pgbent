#!/bin/bash -x

# Repeat run GIS osm2pgsql workload until prompted to stop.
# Execute "touch complete" to signal when you want the testing to end.
# Configure via environment variables.
# Expected to be run via the nohup command.

source ./config
source ./params

rm -f ${STATEDIR}/complete
PID=$$

# Set in seconds, recovery time between runs
if [ -z "$RECOVERY" ] ; then
  RECOVERY=10
fi

# bash booleans inspired by https://stackoverflow.com/a/26920580/118240
# Allows one-liner chains like "(($FIRST)) && cmd && FIRST=0"
FALSE=0
TRUE=1
FIRST=${TRUE}
FAILED=0

while [ ! -f ${STATEDIR}/complete ] ; do
  util/newgis
  if [ $? -ne 0 ] ; then
    echo "util/newgis failed, stopping"
    FAILED=1
    break
  fi

  if !(($FIRST)) ; then
    date
    echo Waiting $RECOVERY seconds for cooldown disk cache recovery
    sleep ${RECOVERY}
  else
    FIRST=${FALSE}
    fi

  # Recheck in case complete appeared during sleep
  if [ ! -f ${STATEDIR}/complete ] ; then
    ./runset &
    P=$!
    echo $PID $P > ${STATEDIR}/pgbent.pid
    echo Set running pid ${P}
    wait $P

    # A finished run with no TPS did not complete. OSM loads stay at 0 when
    # the node rate cannot be computed, which is what a full disk looks like.
    RESULTPSQL="psql -X -h $RESULTHOST -U $RESULTUSER -p $RESULTPORT -d $RESULTDB"
    TPS=`$RESULTPSQL -Atqc "SELECT CASE WHEN tps > 0 THEN 'ok' END FROM tests WHERE server='${SERVERNAME}' ORDER BY test DESC LIMIT 1"`
    if [ "$TPS" != "ok" ] ; then
      echo "Last test has no TPS, stopping"
      FAILED=1
      break
    fi
  fi
done
rm -f ${STATEDIR}/complete ${STATEDIR}/pgbent.pid
exit $FAILED
