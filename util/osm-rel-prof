#!/bin/bash
# Profile the osm2pgsql relation phase.
#
# Started in the background by util/osm-importer when OSMRELPROF=1.
# Polls pg_stat_activity for the slim middle COPY into planet_osm_rels,
# runs `perf record` while that query is present, then writes a text
# report and exits.  A few seconds of edge jitter is acceptable; the
# relation phase runs long enough that it does not matter.
#
# Requires util/pgbent_perf installed under /usr/local/bin with a NOPASSWD
# sudoers rule (same idiom as pgbent_powermon / pgbent_tune).  Artifacts
# land in the current directory (the test results dir when launched from
# osm-importer):
#   osm-rel-perf.data
#   osm-rel-perf-report.txt
#
# Stopping goes through `pgbent_perf stop`.  SIGINT to the sudo wrapper
# does not reliably kill root's `perf record`; leftover system-wide
# recorders have filled disks after the COPY ended.

. ../../../config
. ../../../params

TESTPSQL="psql -X -h $TESTHOST -U $TESTUSER -p $TESTPORT -d $TESTDB -Atq"
# Default poll interval; never sleep with an empty or zero value.
if [ -z "$OSMRELPROF_POLL" ] || [ "$OSMRELPROF_POLL" = "0" ]; then
  POLL_SEC=10
else
  POLL_SEC="$OSMRELPROF_POLL"
fi
if [ -z "$OSMRELPROF_MAX_MB" ] || [ "$OSMRELPROF_MAX_MB" = "0" ]; then
  MAX_MB=8192
else
  MAX_MB="$OSMRELPROF_MAX_MB"
fi
PGBENT_PERF="sudo /usr/local/bin/pgbent_perf"
PERF_DATA="$(pwd)/osm-rel-perf.data"
PERF_REPORT="$(pwd)/osm-rel-perf-report.txt"
PERF_PID=""
STOPPING=0

stop_perf() {
  local reason="$1"
  if [ "$STOPPING" -eq 1 ]; then
    return 0
  fi
  STOPPING=1
  echo "osm-rel-prof: stopping perf ($reason)"
  $PGBENT_PERF stop -o "$PERF_DATA" || true
  if [ -n "$PERF_PID" ]; then
    local i=0
    while [ "$i" -lt 20 ] && kill -0 "$PERF_PID" 2>/dev/null; do
      sleep 1
      i=$((i + 1))
    done
    wait "$PERF_PID" 2>/dev/null || true
    PERF_PID=""
  fi
}

cleanup() {
  stop_perf "signal or exit"
}
trap cleanup EXIT TERM INT

rels_copy_active() {
  $TESTPSQL -c "
SELECT 1
FROM pg_stat_activity
WHERE application_name LIKE 'osm2pgsql%'
  AND query ILIKE '%COPY%planet_osm_rels%'
LIMIT 1"
}

data_bytes() {
  stat -c%s "$PERF_DATA" 2>/dev/null || echo 0
}

echo "osm-rel-prof: waiting for planet_osm_rels COPY"
while true; do
  if [ "$(rels_copy_active)" = "1" ]; then
    break
  fi
  sleep "$POLL_SEC"
done

echo "osm-rel-prof: relation phase detected, starting perf"
rm -f "$PERF_DATA" "$PERF_REPORT"
$PGBENT_PERF record -a -g -o "$PERF_DATA" &
PERF_PID=$!

while true; do
  if [ "$(rels_copy_active)" != "1" ]; then
    break
  fi
  if ! kill -0 "$PERF_PID" 2>/dev/null; then
    echo "osm-rel-prof: perf exited early" >&2
    PERF_PID=""
    exit 1
  fi
  bytes=$(data_bytes)
  if [ "$bytes" -gt $((MAX_MB * 1024 * 1024)) ]; then
    echo "osm-rel-prof: $PERF_DATA exceeded ${MAX_MB}MB, stopping" >&2
    break
  fi
  sleep "$POLL_SEC"
done

stop_perf "planet_osm_rels COPY gone"
trap - EXIT TERM INT

if [ -s "$PERF_DATA" ]; then
  echo "osm-rel-prof: writing $PERF_REPORT"
  if ! $PGBENT_PERF report -i "$PERF_DATA" --stdio > "$PERF_REPORT" 2>&1; then
    echo "osm-rel-prof: perf report failed" >&2
  fi
else
  echo "osm-rel-prof: no perf data collected" >&2
  exit 1
fi

echo "osm-rel-prof: done"
