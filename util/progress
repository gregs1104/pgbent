#!/bin/bash -e
# Snapshot of disk, DB/WAL size, nohup.out, and the current results.txt.
# Follow the OSM loader:
#   util/progress follow
#   util/progress f
FOLLOW=0
case "$1" in
  follow|f) FOLLOW=1 ;;
  "" ) ;;
  *) echo "Usage: $0 [follow|f]" >&2; exit 1 ;;
esac

. ./config
. ./params
TESTPSQL="psql -h $TESTHOST -U $TESTUSER -p $TESTPORT -d $TESTDB"
RESULTPSQL="psql -h $RESULTHOST -U $RESULTUSER -p $RESULTPORT -d $RESULTDB"
df -h | egrep -v "/sys/fs/cgroup|/sys/firmware/|/boot/efi|^/dev/loop|^tmpfs|^efivarfs|^udev|^devfs|/System/Volumes/"
echo
$TESTPSQL -c "SELECT pg_size_pretty(pg_database_size(current_database())) AS db_size,pg_size_pretty(sum(size)) AS wal_used FROM pg_ls_waldir()"
echo
RUNNING=$($RESULTPSQL -Atq -c "
WITH lastset AS (
  SELECT max(set) as lastset from tests
)
SELECT
  server || '/' || test FROM lastset,tests where lastset=tests.set ORDER BY test DESC LIMIT 1;"
)
echo == Running automation:
tail nohup.out
echo
echo == Running test:
if [ "$FOLLOW" -eq 1 ]; then
  tail -f "results/$RUNNING/results.txt"
else
  tail "results/$RUNNING/results.txt"
fi

