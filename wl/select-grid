#!/bin/bash -ex
# select-grid workload for pgbench automation

# pgsysinfo reads TESTPORT from config when PGPORT is unset, and aborts
# (stderr only) if psql cannot connect — so a failed probe cannot append
# garbage into params.

SCRIPT="select"
SETTIMES=3
RUNTIME=60

echo "SCRIPT=$SCRIPT "  > params
echo "SETTIMES=$SETTIMES "  >> params
echo "RUNTIME=$RUNTIME "  >> params
./pgsysinfo >> params

#./runset

echo Finished select-grid workload
