#!/bin/bash -ex
# select-grid workload for pgbench automation

# TODO pgsysinfo runs psql to check the version without looking up parameters.
# When the server is on another port that fails:
#   exit code is '2' / bad command:  'psql -Atc "show server_version"'
# Should at least set PGPORT based on config before calling it.

SCRIPT="select"
SETTIMES=3
RUNTIME=60

echo "SCRIPT=$SCRIPT "  > params
echo "SETTIMES=$SETTIMES "  >> params
echo "RUNTIME=$RUNTIME "  >> params
./pgsysinfo >> params

#./runset

echo Finished select-grid workload
