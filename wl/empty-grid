#!/bin/bash -ex
# empty-grid: lightest pgbench transaction (just `;`)
#
# Protocol plus BEGIN/COMMIT, no query work. Same client grid as
# select-grid. Use SKIPINIT=1 against an existing scale-100 database.

SCRIPT="nothing"
SETTIMES=2
RUNTIME=90

echo "SCRIPT=$SCRIPT"  > params
echo "SETTIMES=$SETTIMES"  >> params
echo "RUNTIME=$RUNTIME"  >> params
./pgsysinfo >> params

echo Finished empty-grid workload
